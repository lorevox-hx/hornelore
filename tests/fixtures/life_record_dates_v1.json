  "server_agreement": {
    "_about": "What the server does with a SUPPLIED {text, value, precision} that differs from what it previously stored. It parses text with the same rules; the supplied value/precision must equal the parse. Valid EDTF alone is not enough.",
    "cases": [
      {
        "id": "agree",
        "supplied": {
          "text": "about 1989",
          "value": "1989~",
          "precision": "year"
        },
        "expect": "accept"
      },
      {
        "id": "wrong-year",
        "supplied": {
          "text": "1987",
          "value": "1989",
          "precision": "year"
        },
        "expect": "refuse"
      },
      {
        "id": "wrong-precision",
        "supplied": {
          "text": "June 1989",
          "value": "1989-06",
          "precision": "year"
        },
        "expect": "refuse"
      },
      {
        "id": "invented-value-for-vague-text",
        "supplied": {
          "text": "after the war",
          "value": "1946",
          "precision": "year"
        },
        "expect": "refuse"
      },
      {
        "id": "vague-text-null",
        "supplied": {
          "text": "after the war",
          "value": null,
          "precision": "unknown"
        },
        "expect": "accept"
      },
      {
        "id": "dropped-qualifier",
        "supplied": {
          "text": "about 1989",
          "value": "1989",
          "precision": "year"
        },
        "expect": "refuse"
      },
      {
        "id": "legacy-precision-not-emitted",
        "supplied": {
          "text": "about 1989",
          "value": "1989~",
          "precision": "approximate"
        },
        "expect": "refuse"
      },
      {
        "id": "invalid-date-text",
        "supplied": {
          "text": "1989-02-30",
          "value": null,
          "precision": "unknown"
        },
        "expect": "refuse"
      },
      {
        "id": "empty-text",
        "supplied": {
          "text": "",
          "value": null,
          "precision": "unknown"
        },
        "expect": "refuse"
      }
    ]
  },
  "legacy_compatibility": {
    "_about": "Stored dates from before C-4. They are READ as they are and never rewritten. A write that carries one UNCHANGED (e.g. re-sending a relationship with its old period while editing its label) is accepted without re-validation; only a date the write actually changes is held to the contract.",
    "cases": [
      {
        "id": "c3-approx-null",
        "stored": {
          "text": "about 1989",
          "value": null,
          "precision": "unknown"
        },
        "unchanged_in_write": "accept",
        "readable": true
      },
      {
        "id": "b-era-approximate",
        "stored": {
          "text": "around 1915",
          "value": "1915~",
          "precision": "approximate"
        },
        "unchanged_in_write": "accept",
        "readable": true
      },
      {
        "id": "b-era-uncertain",
        "stored": {
          "text": "1938?",
          "value": "1938?",
          "precision": "uncertain"
        },
        "unchanged_in_write": "accept",
        "readable": true
      },
      {
        "id": "identity-unknown",
        "stored": {
          "text": "3 March 1941",
          "value": null,
          "precision": "unknown"
        },
        "unchanged_in_write": "accept",
        "readable": true
      }
    ]
  },
  "_rulings": "Supervisor rulings 2026-09-24: 192X has precision year (precision is the granularity of the representation, not a claim of exactness — consumers must read ~ ? % X in value); slashed numeric dates are text only; language-neutral numeric syntax (1989, 1989-06, 1989-06-12, 1989?, 1989~) normalises in any interface language, English lexical phrases normalise in C-4, Spanish lexical phrases are text only; only explicit ongoing wording (to present, now, ongoing, still) opens an interval."
}
