{
  "name": "lorevox",
  "version": "9.0.0",
  "description": "Lorevox \u2014 local-first memoir and life-story platform",
  "private": true,
  "scripts": {
    "audit:ui": "playwright test tests/e2e/lorevox-ui-audit.spec.ts",
    "audit:smoke": "playwright test tests/e2e/lorevox-smoke-flow.spec.ts",
    "audit:all": "playwright test",
    "audit:headed": "playwright test --headed",
    "audit:report": "playwright show-report",
    "test:break": "playwright test tests/e2e/relationship-graph-break.spec.ts",
    "test:break:headed": "playwright test tests/e2e/relationship-graph-break.spec.ts --headed",
    "test:timeline": "playwright test tests/e2e/timeline-integrity.spec.ts",
    "test:memory": "playwright test tests/e2e/focus-canvas-behavior.spec.ts",
    "test:projection": "playwright test tests/e2e/projection-integrity.spec.ts",
    "test:q3": "playwright test tests/e2e/timeline-integrity.spec.ts tests/e2e/focus-canvas-behavior.spec.ts tests/e2e/projection-integrity.spec.ts",
    "test:q3:headed": "playwright test tests/e2e/timeline-integrity.spec.ts tests/e2e/focus-canvas-behavior.spec.ts tests/e2e/projection-integrity.spec.ts --headed",
    "test:bb": "node tests/test_bio_builder_save_sequences.js",
    "test:bb:verbose": "LV_HARNESS_VERBOSE=1 node tests/test_bio_builder_save_sequences.js",
    "test:bb:contract": "node tests/test_questionnaire_save_outcome.js && node tests/test_questionnaire_cache_authority.js && node tests/test_profile_cache_authority.js && node tests/test_single_questionnaire.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/cli": "^4.2.2",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.2.2"
  },
  "main": "tailwind.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {
    "playwright": "1.58.2",
    "playwright-core": "1.58.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
