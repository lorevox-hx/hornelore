# ── Hornelore .gitignore ──────────────────────────────────────────
# Created by WO-11 (repo separation). Keep this minimal and explicit.
# If you add a new build/runtime artifact, add it here — never ignore
# source code, launchers, schemas, or config templates.

# ── Python bytecode / caches ──
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ── Virtual environments (Hornelore-owned) ──
# .venv-gpu (~8 GB), .venv-tts (~7.5 GB) — rebuild from requirements
.venv/
.venv-*/
venv/
env/

# ── Runtime state (logs, pids, signal flags, ephemeral) ──
# Ignore the whole .runtime/ tree. Launcher scripts mkdir -p the
# subdirs they need (logs, pids) and drop transient signal files
# like reset_on_start. None of it should ever be tracked.
.runtime/
*.log
*.log.prev*
*.log.[0-9]*
*.pid

# ── API log snapshots (created by scripts/stop_all.sh) ──
# Each Stop Hornelore.bat copies .runtime/logs/api.log into
# docs/reports/ for post-run review. Snapshots can be 10+ MB;
# never commit them.
docs/reports/api_log_*.txt

# ── Useful (filtered) log snapshots & ad-hoc filtered tails ──
# stop_all.sh writes timestamped + _latest snapshots of the always-on
# filtered useful.log here. scripts/tail_harness_log.sh writes
# harness_filtered_<ts>.log tees here for manual one-off runs. Both
# are evidence artifacts, not source.
docs/reports/useful_log_*.txt
docs/reports/useful_log_latest.txt
docs/reports/harness_filtered_*.log

# ── Local IDE / editor ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Node / Playwright (UI tooling) ──
node_modules/
playwright-report/
test-results/
.playwright/

# ── Models & large binaries (never commit) ──
# Model weights live at MODEL_PATH (see .env.example)
*.safetensors
*.gguf
*.bin
*.onnx
*.pt
*.pth

# ── Database (lives outside repo at DB_PATH) ──
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-journal

# ── Runtime data (memory agents, uploads, etc.) ──
server/data/db/
server/data/memory/

# ── Environment files (secrets / tokens) ──
# Never push .env — it may contain real HF tokens, API keys, etc.
# Use .env.example as the tracked template.
.env
.env.local
.env.*.local
# Timestamped .env backups (e.g. .env.bak_pre_merge_20260504_224854).
# The generic *.bak rule below doesn't catch these because the timestamp
# is a suffix after .bak, so add an explicit pattern here.
.env.bak*
.env.backup*
# Any other timestamped/prefixed .env copy an operator makes before an edit
# (e.g. .env.before-google-picker.20260727-181500). Without this, a backup
# named anything other than .env.bak*/.env.backup* shows up as an UNTRACKED
# file in GitHub Desktop with real credentials in it.
.env.*
!.env.example

# ── OS / tool junk ──
*.orig
*.rej
*.bak

# ── Word temp files (created while .docx is open) ──
~$*

# TEST-23 harness Playwright artifacts (regenerated per run; structured
# reports in docs/reports/test23_*.{json,md,csv,txt} carry the evidence)
docs/reports/test23_*_*.downloads/
docs/reports/test23_*_*.screenshots/

# agent session state
.claude/

# runtime DB (live narrator data)
data/hornelore.sqlite
.fuse_hidden*

# WO-LORI-STORY-CAPTURE-01 — filesystem mirror of captured stories.
# Self-contained per-story folders (audio + transcript + metadata)
# written under DATA_DIR/stories-captured/ when HORNELORE_STORIES_
# CAPTURED_FS=1 fires. Runtime data, NEVER goes in git.
data/stories-captured/

# WO-LORI-FACTUAL-CHAIN-CAPTURE-01 — live harness reports. Each
# run of scripts/run_factual_chain_live_harness.py and
# scripts/run_trip_route_canary_harness.py writes a timestamped
# .txt report under docs/reports/. Runtime artifacts; do not
# accumulate as untracked entries. If a specific run needs to be
# banked as evidence, copy it under a different name and add by
# hand.
docs/reports/factual_chain_live_*.txt
docs/reports/trip_route_canary_*.txt
docs/reports/trip_2019_france_italy_*.txt
# Throwaway commit-message helper files (git commit -F). One glob so
# this never needs another .gitignore edit. See CLAUDE.md git-hygiene note.
.git-commit-msg*.txt

# Code-review transfer artifacts (2026-07-24) — never commit archives
_to_delete/
*.tar.gz
