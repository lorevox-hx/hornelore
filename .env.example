# =========================
# Hornelore 1.0 — Horne Family Archive
# Based on Lorevox 9.0 stack
# =========================

# =========================
# PRIMARY GPU MODEL (Hornelore-owned copy — WO-11 separation boundary)
# =========================
# WO-11: Hornelore now has its own model copy at /mnt/c/models/hornelore.
# This lets Hornelore swap models (Hermes, Qwen, etc.) without affecting
# the Lorevox copy at /mnt/c/Llama-3.1-8B. The HF cache (HF_HOME /
# TRANSFORMERS_CACHE) is also Hornelore-local so transformer downloads
# don't cross-contaminate.
MODEL_ID=meta-llama/Meta-Llama-3.1-8B-Instruct
QUANT=4bit
MAX_NEW_TOKENS=3072
# ── the two windows, separated 2026-08-04 (Phase 2C) ──────────────────
# MAX_CHAT_PROMPT_TOKENS       how much of a CHAT prompt survives before
#                              the front is sliced off. Overrun here is
#                              SILENT and costs Lori her instructions.
# MAX_EXTRACTION_CONTEXT_WINDOW  the fail-closed ceiling the bounded
#                              extraction budget refuses against. Overrun
#                              here REFUSES the extraction, by design.
#
# Both default to 8192, and to the legacy MAX_CONTEXT_WINDOW below when
# that is set, so an existing .env keeps working unchanged.
#
# MAX_CONTEXT_WINDOW is DEPRECATED. It is still read as the fallback for
# both, and the server prints a deprecation line when it is used, but it
# no longer exists as a constant in the code — one ambiguous name
# governing two unrelated policies is the defect Phase 2C removed.
MAX_CHAT_PROMPT_TOKENS=8192
MAX_EXTRACTION_CONTEXT_WINDOW=8192
MAX_CONTEXT_WINDOW=8192
TEMPERATURE=0.3

# =========================
# WO-QA tunables — live chat defaults (cfg_expressive winner from WO-QA-02)
# =========================
# Production defaults selected from the WO-QA-02 quality harness — see
# docs/wo-qa/WO-QA-02-RESULTS.md for the rationale. cfg_expressive ranked
# #1 across both narrator styles in two consecutive matrix runs (suppression
# noise floor ±4). UI also sends temperature=0.7 + max_new_tokens=512
# explicitly per request (app.js); env values back-stop those.
#
# MAX_NEW_TOKENS_CHAT        — floor when UI omits params.max_new_tokens
# MAX_NEW_TOKENS_CHAT_HARD   — absolute server-side ceiling for chat WS
# REPETITION_PENALTY_DEFAULT — applied when UI omits params.repetition_penalty;
#                               WO-QA harness sweeps this per-request via params
MAX_NEW_TOKENS_CHAT=512
MAX_NEW_TOKENS_CHAT_HARD=2048
REPETITION_PENALTY_DEFAULT=1.05

# =========================
# Extraction tuning — /api/extract-fields LLM call parameters
# =========================
# EXTRACTION_TEMP         — generation temperature for extraction (default 0.15)
# EXTRACTION_TOP_P        — nucleus sampling for extraction (default 0.9)
# MAX_NEW_TOKENS_EXTRACT  — token cap for simple single-fact answers (default 128)
# MAX_NEW_TOKENS_EXTRACT_COMPOUND — token cap for compound multi-entity answers (default 384)
EXTRACTION_TEMP=0.15
EXTRACTION_TOP_P=0.9
MAX_NEW_TOKENS_EXTRACT=128
MAX_NEW_TOKENS_EXTRACT_COMPOUND=384

MODEL_PATH=/mnt/c/models/hornelore/Meta-Llama-3.1-8B-Instruct
MODEL_DIR=/mnt/c/models/hornelore
HF_HOME=/mnt/c/models/hornelore/hf_home
TRANSFORMERS_CACHE=/mnt/c/models/hornelore/hf_home

# =========================
# CUDA / Torch Tuning
# =========================
TORCH_DTYPE=bfloat16
DEVICE_MAP=cuda:0
PYTORCH_ALLOC_CONF=max_split_size_mb:128
LOAD_IN_4BIT=1
ATTN_IMPL=sdpa

# =========================
# Hugging Face Auth
# =========================
HUGGINGFACE_HUB_TOKEN=hf_REPLACE_WITH_YOUR_TOKEN
HF_HUB_ENABLE_HF_TRANSFER=1
HF_HUB_ENABLE_XET=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# =========================
# RAG + Embeddings
# =========================
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DEVICE=cpu
MEMORY_K=6
FAISS_PATH=code/rag/index

# =========================
# HORNELORE DATA — SEPARATE from Lorevox
# =========================
DATA_DIR=/mnt/c/hornelore_data
AUTHORS_DIR=/mnt/c/hornelore_data/authors
KNOWLEDGE_DIR=/mnt/c/hornelore_data
DB_NAME=hornelore.sqlite3
DB_PATH=/mnt/c/hornelore_data/hornelore.sqlite3
UPLOADS_DIR=/mnt/c/hornelore_data/uploads
MEDIA_DIR=/mnt/c/hornelore_data/media
MAX_UPLOAD_MB=50

# =========================
# Coqui TTS (WO-11: Hornelore-local cache to survive lorevox retirement)
# =========================
TTS_DEVICE=cpu
TTS_GPU=0
TTS_MODEL=tts_models/en/vctk/vits
TTS_SPEAKER_LORI=p335
TTS_HOME=/mnt/c/hornelore_data/tts_cache

# WO-ML-TTS-EN-ES-01 — pluggable TTS engine selector.
#   coqui  (default) → existing English-only Coqui VCTK VITS, byte-stable
#                       with pre-WO behavior. No new pip deps required.
#   kokoro            → Apache 2.0 multilingual (en + es + fr/it/pt/ja/zh/hi).
#                       Requires: pip install kokoro phonemizer
#                                 + apt-get install espeak-ng (for non-EN)
# Set to "kokoro" only after pip install completes (see scripts/setup/
# install_kokoro.sh). Leaving unset / "coqui" preserves existing behavior.
LORI_TTS_ENGINE=coqui

# Kokoro voice defaults — engine-specific keys, ignored when LORI_TTS_ENGINE
# is "coqui". Voice list at https://github.com/hexgrad/kokoro
#   English (lang_code='a'): af_heart, af_bella, af_nova, af_sarah,
#                             am_michael, am_eric, am_liam, am_onyx
#   Spanish (lang_code='e'): ef_dora, em_alex, em_santa
LORI_TTS_KOKORO_VOICE_EN=af_heart
LORI_TTS_KOKORO_VOICE_ES=ef_dora

# =========================
# Server + CORS
# =========================
HOST=127.0.0.1
PORT=8000
TTS_PORT=8001
CORS_ORIGINS=*

# =========================
# Interview Driver
# =========================
AUTO_NEXT=1
AUTO_NEXT_STRATEGY=plan_order

# =========================
# STT
# =========================
STT_MODEL=large-v3
STT_GPU=1

# =========================
# Feature Flags
# =========================
# HORNELORE_SAFETY_STATE — WO-LEAN-LORI-RUNTIME-01 Phase 3B (2026-08-04).
# The whole runtime safety feature: "parked" or "active". Default PARKED.
#
# LEAN LORI IS NOT AN EMERGENCY-MONITORING SERVICE. It is a family
# oral-history system. Nobody is watching it, nobody is on call, and it
# makes no promise of response. An always-on emergency apparatus in that
# context bought a real cost and a false impression at the same time,
# and the false impression is the more serious half: a system that
# produces crisis-line scripts can read, to the person using it, as a
# system that is watching over them.
#
# WHAT PARKED MEANS — inactive at runtime, fully preserved in the repo,
# the way Companion mode is parked. Nothing is deleted.
#   * the LLM safety classifier performs ZERO generations
#   * the detailed safety protocol contributes ZERO prompt tokens
#     (7,933 chars, 44% of DEFAULT_CORE, ~1,800 tokens)
#   * deterministic scanning and the operator cascade are inactive
#   * browser detection, the keyword latch and the posture are inactive
#   * softened mode and safety notifications are inactive
#
# ONE AUTHORITY, THREE MECHANISMS. Prompt, server and browser all ask
# this one setting. The browser is TOLD the answer via
# GET /api/runtime-posture; it is not trusted to agree independently.
# LV_ENABLE_SAFETY and HORNELORE_SAFETY_LLM_LAYER below are SUBORDINATE:
# when parked they are not consulted at all, so no combination of stale
# values can bring one piece of a parked feature back on its own.
#
# An unrecognised value resolves to "parked". A typo must not switch an
# entire feature family on.
#
# REACTIVATION IS A DECISION, NOT A CONFIG CHANGE. Setting "active" is
# mechanically sufficient and deliberately not sufficient on its own.
# Before safety runs against a real narrator again it needs its own
# efficacy and specificity acceptance, because the measured behaviour of
# 2026-08-04 includes the deterministic layer classifying
#   "I've had a good run. I'm not afraid of the ending."
# as domestic_abuse and routing it to a crisis line, overruling an LLM
# that read it correctly as mortality reflection. See
# docs/decisions/2026-08-04-park-safety-feature.md.
HORNELORE_SAFETY_STATE=parked

# LV_ENABLE_SAFETY — WO-LORI-SAFETY-INTEGRATION-01 Phase 7 kill-switch.
# SUBORDINATE to HORNELORE_SAFETY_STATE since 2026-08-04: not consulted
# at all while parked. Applies only when the state is "active".
# Default 1 (safety enabled). Setting to 0 DISABLES the entire chat-path
# safety pipeline: pattern scan, LLM second-layer, segment_flag
# persistence, softened-mode, operator notification, and the discipline
# exemption.
#
# DEVELOPER USE ONLY. Use cases:
#   - Automated chat-path tests where deterministic safety routing
#     would mask normal-turn behavior under inspection
#   - Eyeballing a clean composer / extractor surface without safety
#     interjections
#
# NEVER set to 0 in a real narrator session. The ACUTE SAFETY RULE in
# the system prompt still fires unconditionally, but operator
# visibility, segment_flag persistence, and softened-mode all DISAPPEAR.
# When LV_ENABLE_SAFETY=0, every turn emits a [chat_ws][safety][KILL-SWITCH]
# WARNING in api.log so the disabled state is visible to operators
# inspecting logs mid-session.
LV_ENABLE_SAFETY=1
# LV_ENABLE_AFFECT / LV_ENABLE_CAMERA / LV_ENABLE_TTS — vestigial flags
# from earlier prototypes; not currently read by server code. Listed
# here so .env.example stays in sync with .env. Wire-in-or-delete is
# tracked separately (post-parent-session).
LV_ENABLE_AFFECT=1
LV_ENABLE_CAMERA=1
LV_ENABLE_TTS=1
# WO-13: Family Truth v2 pipeline flags
# facts_write — freezes legacy /api/facts/add (returns 410 Gone)
HORNELORE_TRUTH_V2=1
# profile — GET /api/profiles/{id} reads from family_truth_promoted
HORNELORE_TRUTH_V2_PROFILE=1

# WO-EX-VALIDATE-01 — age-math plausibility gate in /api/extract-fields.
# When 1, extractor drops items flagged 'impossible' (e.g., first_job at
# age 4, Medicare before 65) and annotates others with plausibility_flag.
# Default 0 — enable only after live validation verifies no false positives.
HORNELORE_AGE_VALIDATOR=0

# WO-LIFE-SPINE-05 — phase-aware question composer.
# When 1, interview router picks questions from data/prompts/question_bank.json
# based on narrator current age vs phase age ranges. Falls back to sequential
# DB ordering when narrator has no DOB or bank is unavailable.
# Default 0 — keep tomorrow's test on the known-good sequential flow.
HORNELORE_PHASE_AWARE_QUESTIONS=0

# WO-EX-TWOPASS-01 — two-pass extraction pipeline.
# When 1, /api/extract-fields uses span-tagger (pass 1) + field-classifier
# (pass 2) instead of single-pass LLM extraction. Falls back to single-pass
# on pass 1 failure. Default 0 — enable after A/B eval confirms improvement.
HORNELORE_TWOPASS_EXTRACT=0

# WO-LORI-PHOTO-SHARED-01 — Phase 1 photo authority layer.
# When 1, the /api/photos router is live (curator upload, narrator show-next,
# photo_memory capture, session-end finalization). When 0, every endpoint
# under /api/photos returns 404 so the surface is invisible to the UI.
# Phase 2 flags HORNELORE_PHOTO_INTAKE and HORNELORE_PHOTO_ELICIT only take
# effect when this flag is also on.
HORNELORE_PHOTO_ENABLED=0

# =========================
# WO-LORI-SAFETY-INTEGRATION-01 Phase 3 — operator notification surface
# =========================
# Backend gate for /api/operator/safety-events* endpoints (Bug Panel
# banner + between-session digest). Default 0 → every endpoint returns
# 404 so it doesn't advertise itself. Set to 1 once the Bug Panel UI
# (Phase 3b) is wired and you're ready for the operator surface.
# Note: this is single-operator local-first software — when Lorevox
# adopts these endpoints they'll be fronted with operator-tab auth.
HORNELORE_OPERATOR_SAFETY_EVENTS=0

# =========================
# DB inspector (dev-only)
# =========================
# Backend gate for /db/tables and /db/table/{name} endpoints. Default 0 →
# every endpoint returns 404 so the route doesn't advertise itself. Set
# to 1 only when actively debugging schema / row content. Sensitive
# columns (content, profile_json, value, turn_excerpt, matched_phrase,
# etc.) are still redacted unless LV_DEV_MODE=1 is also set.
# Turn OFF for parent sessions.
HORNELORE_DB_INSPECTOR=0

# =========================
# WO-BUG-PANEL-EVAL-HARNESS-01 Phase 1 — read-only eval cockpit
# =========================
# Backend gate for /api/operator/eval-harness/* endpoints (Bug Panel
# Eval Harness section). Default 0 → every endpoint returns 404 so it
# doesn't advertise itself. Set to 1 once the Bug Panel UI is live and
# you want the Extractor / Lori Behavior / Safety / Story Surface
# status cards visible. Read-only in Phase 1 — no run buttons.
HORNELORE_OPERATOR_EVAL_HARNESS=0

# =========================
# WO-OPERATOR-RESOURCE-DASHBOARD-01 — live stack/resource cockpit
# =========================
# Backend gate for /api/operator/stack-dashboard/* endpoints (Bug Panel
# Stack Dashboard section). Default 0 → every endpoint returns 404 so
# the surface doesn't advertise itself. Set to 1 to enable the
# car-dashboard-style live gauges for CPU, RAM, GPU, services, capture
# state, archive writes, and eval progress. Read-only.
#
# Optional threshold overrides (all default-good; override only if your
# box runs hot or you want different amber/red lines):
#   DASH_CPU_AMBER (default 80)        DASH_CPU_RED (default 95)
#   DASH_RAM_AMBER (default 80)        DASH_RAM_RED (default 95)
#   DASH_DISK_AMBER (default 85)       DASH_DISK_RED (default 95)
#   DASH_VRAM_FREE_AMBER_MB (default 2048)  DASH_VRAM_FREE_RED_MB (default 512)
#   DASH_GPU_TEMP_AMBER (default 82)        DASH_GPU_TEMP_RED (default 92)
#   DASH_SVC_LATENCY_AMBER_MS (default 2000) DASH_SVC_LATENCY_RED_MS (default 10000)
#   DASH_UI_HEARTBEAT_TTL_SEC (default 30 — past this, capture cards go unknown)
#   DASH_ARCHIVE_STALE_AMBER_SEC (default 60)  DASH_ARCHIVE_STALE_RED_SEC (default 300)
#   DASH_EVAL_STALE_AMBER_SEC (default 30)     DASH_EVAL_STALE_RED_SEC (default 120)
HORNELORE_OPERATOR_STACK_DASHBOARD=0

# WO-OPS-STRESS-TELEMETRY-KV-01 — KV/VRAM cleanup endpoint.
# When 1 (AND HORNELORE_OPERATOR_STACK_DASHBOARD=1), exposes
# POST /api/operator/stack-dashboard/clear-kv which runs
# torch.cuda.empty_cache() + gc.collect() + torch.cuda.ipc_collect()
# and returns before/after VRAM stats. Used by the rehearsal harness's
# --clear-kv-between-voices flag during multi-voice stress runs to
# release accumulated KV-cache pressure between narrators.
# Two gates because clear-kv mutates runtime state (vs read-only
# summary/history) — opt-in only. Default-off returns 404 so the
# endpoint doesn't advertise itself.
HORNELORE_OPERATOR_CLEAR_KV=0

# =========================
# WO-LORI-STORY-CAPTURE-01 — story preservation lane
# =========================
# Master switch for the story preservation path (Path 1 in the WO).
# Default 0 → preservation is INERT (chat_ws does not call into the
# preservation service even if the table exists). Set to 1 to enable
# Lori's "remember this story" behavior in live sessions.
#
# Phase 1A note: setting this to 1 has NO effect until Phase 1A
# Commit 3b lands the chat_ws integration. The flag is reserved here
# so .env doesn't need to change again when 3b lands.
HORNELORE_STORY_CAPTURE=0

# Story-trigger thresholds. The classifier (services/story_trigger.py)
# fires "full_threshold" when ALL three of (duration ≥ MIN_DURATION_SEC,
# words ≥ MIN_WORDS, scene_anchor_count ≥ 1) are met. It fires
# "borderline_scene_anchor" when scene_anchor_count ≥ MIN_BORDERLINE
# (high anchor density rescues short turns — Janice's actual
# mastoidectomy story is below the duration/word floor but rich in
# place + relative-time + person-relation references).
#
# Defaults match WO-LORI-STORY-CAPTURE-01_Spec.md §3.3. Tune if a
# narrator runs systematically below or above the trigger floor.
STORY_TRIGGER_MIN_DURATION_SEC=30
STORY_TRIGGER_MIN_WORDS=60
STORY_TRIGGER_BORDERLINE_ANCHOR_COUNT=3

# rich_short_narrative trigger path (added 2026-05-09). Catches the
# compact emotive turns common in Spanish elder-narrator speech where
# content is rich but word/duration counts fall below full_threshold
# AND only 2 of 3 anchor axes fire (so borderline's 3-axis floor
# misses them too). Real motivating example: María's first turn —
# "Hola Lori, me llamo María. Cuando mi abuela hablaba de Perú, yo
# escuchaba su voz y me sentía cerca de ella." (21 words, ~15s,
# place + person anchors). Requires PLACE + (PERSON or TIME) AND
# words ≥ MIN_WORDS AND duration ≥ MIN_DURATION_SEC. The dual-anchor
# floor distinguishes a real memory from a place mention.
STORY_TRIGGER_RICH_SHORT_MIN_WORDS=15
STORY_TRIGGER_RICH_SHORT_MIN_DURATION_SEC=10

# WO-LORI-STORY-CAPTURE-01 Phase 1B — minimal operator review surface.
# When 1, exposes GET /api/operator/story-candidates so the Bug Panel
# can render an unreviewed-candidates list. Default-off so the route
# doesn't advertise itself to outside probes (404 when off). Phase 1B
# is read-only; promote/refine/discard actions arrive in Phase 3.
HORNELORE_OPERATOR_STORY_REVIEW=0

# WO-LORI-SAFETY-LLM-CLASSIFIER-01 (2026-06-14) — past-tense flag
# review surface. When 1, exposes GET /api/operator/past-tense-flags
# so the Bug Panel can render a list of past_tense_ideation_
# acknowledged segment_flags across all sessions, newest-first. This
# is the operator's read window for past-tense memoir ideation
# disclosures (the classifier's past_tense_acknowledge route writes
# these). Default-off so the route doesn't advertise itself (404 when
# off). Read-only in v1 — the 3-decision affordance (no_action /
# follow_up_outside_session / convert_to_active_concern) renders as
# disabled buttons; state transitions land in a follow-up WO.
HORNELORE_OPERATOR_PAST_TENSE_REVIEW=0

# WO-LORI-WITNESS-FOLLOWUP-BANK-01 — patience-layer operator surface.
# When 1, exposes /api/operator/followup-bank/* endpoints so the Bug
# Panel can render the per-session bank of unanswered story doors
# (banked questions Lori noticed but hasn't asked yet). Default-off
# so the route doesn't advertise itself (404 when off). Read-only +
# mark-answered. The bank service ITSELF (door detection, write,
# flush) runs unconditionally on every STRUCTURED_NARRATIVE turn —
# only the operator surface is gated.
HORNELORE_OPERATOR_FOLLOWUP_BANK=0

# WO-BIO-QUESTIONNAIRE-BIO-FACTS-MIGRATE-01 (2026-06-16) — Phase 1
# read swap. When 1, db.get_questionnaire() routes through the new
# bio_questionnaire_view service: questionnaire content is aggregated
# from canonical truth (people row + profile_json + bio_facts) instead
# of the legacy bio_builder_questionnaires blob. This closes the gap
# where the operator intake form (WO-OPERATOR-NEW-NARRATOR-INTAKE-
# FORM-01) writes to bio_facts + profile_json, so a fresh narrator
# would otherwise look empty in the Bio Builder questionnaire UI even
# though 24 bio_facts + structured profile_json rows exist for them.
# Default-off so existing narrators with saved blob content keep
# rendering byte-stable during rollout. Flip to 1 ONLY after Phase 7.5
# legacy-backfill readiness report signs off + live verify confirms a
# clean view for at least one narrator.
HORNELORE_QUESTIONNAIRE_BIO_FACTS_READ=0

# WO-BIO-QUESTIONNAIRE-BIO-FACTS-MIGRATE-01 (2026-06-16) — Phase 3
# write fan-out gate. When 1, PUT /api/bio-builder/questionnaire fans
# the questionnaire blob out to canonical truth:
#   - scalar fields → bio_facts at status='operator_entered', tier=4
#   - structured arrays + blocks → profile_json (merge=True)
# Default-off so existing PUT behavior is byte-stable during rollout.
# Flip to 1 ONLY after Phase 5 test pack signs off + Phase 6 code
# review checklist is complete + at least one narrator has been
# verified end-to-end (questionnaire PUT → bio_facts rows + Lori
# memory_echo readback).
HORNELORE_QUESTIONNAIRE_BIO_FACTS_WRITE=0

# WO-BIO-QUESTIONNAIRE-BIO-FACTS-MIGRATE-01 (2026-06-16) — Phase 3
# legacy-blob write switch. When 1 (default), PUT writes continue to
# land in the legacy bio_builder_questionnaires blob. When 0, the
# legacy blob is skipped entirely (canonical-only mode — the post-
# retirement state).
#
# Combined with HORNELORE_QUESTIONNAIRE_BIO_FACTS_WRITE:
#   FANOUT=0 + LEGACY=1 (default): status quo, legacy blob only
#   FANOUT=1 + LEGACY=1:           dual-write (safest for rollout)
#   FANOUT=1 + LEGACY=0:           canonical-only (after Phase 7.5
#                                  retirement signs off)
#   FANOUT=0 + LEGACY=0:           ❌ DO NOT USE — writes go nowhere.
#                                  The PUT route refuses no-write
#                                  configurations is a TODO; for now
#                                  flip the flags together.
HORNELORE_QUESTIONNAIRE_LEGACY_BLOB_WRITE=1

# WO-EX-UTTERANCE-FRAME-01 Phase 0-2 — observability log only.
# When 1, chat_ws emits a single [utterance-frame] log line per
# narrator turn carrying the Story Clause Map summary (subject class,
# event class, place, negation/uncertainty flags, candidate field
# hints). Default-off because this is a Phase 0-2 instrumentation
# flag, not a feature flag — the frame produces NO behavior change
# regardless of this setting. Consumers (extractor binding, Lori
# echo grounding, validator) wire in later phases under their own
# flags.
#
# Pure observability:
#   - Frame is built from narrator text only (no DB, no LLM, no IO).
#   - Frame is NOT consumed by extractor / Lori / safety / UI.
#   - Frame failure is non-fatal — turn always continues.
#   - System directives ([SYSTEM_QF: ...]) are skipped (same rule as
#     story-trigger logging).
#
# Use case: turn this on for a session you want to survey, then grep
# api.log for `[utterance-frame]` to inspect what the parser produces
# on real narrator-shaped text.
HORNELORE_UTTERANCE_FRAME_LOG=0

# WO-NARRATIVE-CUE-LIBRARY-01 Phase 4 — observability log only.
# When 1, chat_ws emits a single [lori-cue] log line per narrator turn
# carrying the top cue type detected from the v1 cue library
# (parent_character / elder_keeper / journey_arrival / home_place /
# work_survival / hearth_food / object_keepsake / language_name /
# identity_between / hard_times / hidden_custom / legacy_wisdom),
# its risk level, score, and which trigger terms fired. Default-off
# because this is a Phase 4 instrumentation flag, not a feature flag —
# the cue library produces NO behavior change to live narrator
# sessions regardless of this setting. The cue library is a LISTENER
# AID per the WO spec; truth flows only through the existing
# extractor → Review Queue → promoted History pipeline.
#
# Pure observability:
#   - Cue is detected from narrator text only (no DB, no LLM, no IO).
#   - Cue is NOT consumed by Lori / extractor / safety / UI.
#   - Cue failure is non-fatal — turn always continues.
#   - System directives ([SYSTEM_QF: ...]) are skipped (same rule as
#     story-trigger and utterance-frame logging).
#
# Use case: turn this on for a session you want to survey, then grep
# api.log for `[lori-cue]` to inspect which cue types fire on real
# narrator-shaped text. Feed observations back into the library JSON
# (data/lori/narrative_cue_library.v1.seed.json) via the eval harness
# (scripts/run_narrative_cue_eval.py). Phase 5+ wires the cue into
# Lori's response composer behind a separate flag.
HORNELORE_LORI_CUE_LOG=0

# TRUTH-PIPELINE-01 Phase 1 (Gate 7) --- truth-write observability.
# When 1, every narrator turn records WHICH of the five truth-write
# stages fired and chat_ws emits ONE [truth-pipeline] line per turn:
#   raw_turn_saved / archive_event_created / extract_fields_called /
#   family_truth_written / projection_updated
# The operator harness also returns the same summary as a
# `truth_pipeline` object on its interview-turn response, keyed by the
# turn_id it already mints, so a harness run can read a turn back
# without any new column.
#
# Pure observability:
#   - No routing change, no retry, no fallback, no new behavior.
#   - No DB row, no table, no migration --- records live in a bounded
#     in-memory ring that dies with the process.
#   - Never reaches the narrator surface (CLAUDE.md:44 no operator
#     leakage / no diagnostic surfaces).
#   - Probe failure is swallowed --- a turn never breaks on it.
#   - Ids and counts only in the log line; no narrator text.
#
# Use case: the operator harness reports `speaker_zero_delta` --- "turn
# did not write anywhere". Three readings were live and unresolvable:
# a real routing bug, a harness coverage gap, or correct-by-design
# silence for a synthetic harness-test narrator. Turn this on, run one
# harness turn, and read `truth_pipeline` (or grep api.log for
# `[truth-pipeline]`) to tell them apart. A stage reading 0 is evidence,
# not a defect --- Phase 2/3 routing fixes stay deferred until this
# evidence lands.
HORNELORE_TRUTH_PIPELINE_LOG=0

# WO-LORI-SESSION-AWARENESS-01 Phase 1c-wire — Peek-at-Memoir live wiring.
# When 1, chat_ws's memory_echo branch threads promoted_truth +
# safety-filtered transcript into runtime71["peek_data"]. The composer
# (compose_memory_echo) renders a new "From our records" section
# surfacing facts that the family_truth promotion pipeline has approved.
# Default-OFF because surfacing promoted truth is a real narrator-facing
# behavior change that should be Chris-validated on the parent-session
# readiness harness before flipping live.
#
# Pure read path:
#   - Reads from family_truth_promoted (db.ft_list_promoted)
#   - Reads from session transcript (archive.read_transcript)
#   - Pipes transcript through safety.filter_safety_flagged_turns
#     (Phase 5c) so distress turns NEVER appear in memory_echo
#   - Failure on any underlying read is captured in errors[] and
#     logged; turn always continues
#
# When this flag is on, every memory_echo turn ("what do you know
# about me?") includes promoted facts. When off, runtime71 has no
# peek_data key and the composer skips the new section entirely
# (byte-stable with pre-Phase-1c behavior).
HORNELORE_PEEK_AT_MEMOIR_LIVE=0

# WO-LORI-SAFETY-INTEGRATION-01 Phase 2 — LLM second-layer safety classifier.
# When 1, chat_ws.py invokes the LLM-side safety classifier
# (server/code/api/safety_classifier.py) in parallel with the existing
# deterministic pattern detector (safety.py / scan_answer). Catches
# indirect ideation language that regex patterns can't safely match
# by design — examples: "everyone would be better off without me",
# "I just don't see the point in any of this anymore", "I want it
# to be over". Distinguishes past-tense reflective from present-tense
# distressed/ideation/acute.
#
# Composition rule (locked, see WO spec):
#   - Pattern detector wins on positive detection (always)
#   - LLM classifier fills gaps — only used when pattern returns None
#   - On parse failure or LLM error, falls back to pattern (fail-OPEN)
#
# Default-off because (1) each turn adds ~1-2s LLM round-trip latency;
# (2) needs Phase 6 red-team validation before live narrator use; (3)
# pattern layer is already the safety floor and has been live since
# Phase 1 (2026-04-29).
#
# Use case: Chris flips this for a session of red-team probes, greps
# api.log for [safety_classifier] markers, and verifies the LLM-side
# layer catches indirect ideation cases the pattern layer misses
# without false-positive over-firing on normal narrative.
#
# SUBORDINATE to HORNELORE_SAFETY_STATE since 2026-08-04 (Phase 3B): not
# consulted at all while parked. Applies only when the state is "active".
HORNELORE_SAFETY_LLM_LAYER=0

# BUG-LORI-SAFETY-FALSE-POSITIVE-EXTERNAL-FEAR-01 (2026-05-09) — LLM-side
# confidence floor for routing distressed/ideation classifications to
# the 988-dispatching safety pipeline. Reaction to Mary's session: the
# LLM second-layer false-positived "I am kind of scared, are you safe to
# talk to?" into distressed/ideation at ~0.5 confidence and 988'd an
# 86yo who was anxious about the AI itself. This floor blocks
# low-confidence Llama-3.1-8B chatty guesses on ambiguous narrator
# anxiety while still admitting confident ideation flags.
#
# 0.65 default — empirically: high enough to filter false-positive
# external-fear classifications, low enough that "no point getting up
# anymore" easily clears 0.65 even on a small model.
#
# Acute is exempt — the LLM saying 'acute' (explicit self-harm
# language) always routes regardless of confidence, since the cost of
# missing acute >> the cost of a false positive on acute.
#
# Pattern-side detections in safety.py are NOT affected by this floor;
# they have their own per-pattern confidence thresholds.
HORNELORE_SAFETY_LLM_CONFIDENCE_FLOOR=0.65

# WO-INTERVIEW-CLOCK-01 (2026-05-02) — narrator orientation clock place
# line. Static config string, single key. NOT browser geolocation,
# NOT IP-geolocation — both are wrong-when-wrong in alarming ways for
# an older-adult kiosk install. Empty value collapses the place line
# cleanly per WO design rule (clock still renders time + day + date).
#
# Per-narrator override available via localStorage["lvNarratorLocation"]
# (operator dev convenience). Server-side wiring of this env var into
# the UI is pending — current v1 reads window.LV_NARRATOR_LOCATION OR
# localStorage. To set a stack-wide default before that wiring lands:
#     export LOREVOX_NARRATOR_LOCATION="Las Vegas, New Mexico"
#   in the shell that runs start_all.sh, then manually mirror it via
#     localStorage.setItem("lvNarratorLocation", "Las Vegas, New Mexico")
#   in the narrator browser. Phase 2 will inject this at server-render
#   time so the manual mirror step is no longer needed.
LOREVOX_NARRATOR_LOCATION=

# WO-LORI-HARNESS-01 — operator harness HTTP shim over /api/chat/ws.
# When 1, exposes POST /api/operator/harness/interview-turn so the
# golfball harness (and other ops scripts) can run synchronous chat
# turns via a stable HTTP contract instead of speaking the WS protocol.
# Default-off so the route doesn't advertise itself to outside probes
# (404 when off). The endpoint internally opens a WebSocket to its own
# /api/chat/ws — server eats its own dogfood — so the contract stays
# accurate to chat_ws.py without code duplication.
HORNELORE_OPERATOR_HARNESS=0

# Soft session-end pacing. At LORI_SESSION_SOFT_WARN_MIN minutes Lori
# offers a break. At LORI_SESSION_HARD_CAP_MIN minutes the session
# ends warmly (does NOT cut narrator audio mid-utterance — waits for
# the current turn to finish). Both reserved here for Phase 2 use.
LORI_SESSION_SOFT_WARN_MIN=25
LORI_SESSION_HARD_CAP_MIN=30

# =========================
# WO-LORI-QUESTION-ATOMICITY-01 / WO-LORI-REFLECTION-01
# =========================
# Layer 2 deterministic atomicity filter. When set, runs
# enforce_question_atomicity() on assistant_text after the LLM stream
# completes (post-stream, pre-`done` event). Truncates at the first
# pivot when one of the 6 illegal-structure patterns fires
# (and_pivot / or_speculation / request_plus_inquiry / choice_framing
# / hidden_second_target / dual_retrieval_axis). Default OFF for the
# first eval cycle — flip to 1 after the golfball harness shows
# atomicity_failures==0 across two consecutive runs and the master
# extractor eval shows no regression. Skips when the safety classifier
# has triggered for the turn.
HORNELORE_ATOMICITY_FILTER=0

# Layer 1 (the LORI_QUESTION_ATOMICITY directive in
# prompt_composer.py / LORI_INTERVIEW_DISCIPLINE) is always on; it
# rides on every interview-side composer regardless of this flag.

# Memory-echo validator (WO-LORI-REFLECTION-01). Validator-only — no
# mutation of assistant_text. Logs failure labels via
# [chat_ws][reflection] log marker. Operators can correlate label
# rates with prompt-composer changes. Default OFF for the first eval
# cycle.
#
# DEPRECATED 2026-05-01: superseded by HORNELORE_COMMUNICATION_CONTROL
# below. The unified wrapper composes both atomicity and reflection
# enforcement. Kept for backward compat / staged rollout.
HORNELORE_REFLECTION_VALIDATOR=0

# WO-LORI-COMMUNICATION-CONTROL-01 — unified runtime communication
# guard. Composes question_atomicity (truncate compounds) +
# lori_reflection (validate echo) and adds:
#   * Per-session-style word-count limits:
#       clear_direct=55 / warm_storytelling=90 /
#       questionnaire_first=70 / companion=80
#   * Question-count cap (≤1 per turn)
#   * Acute-safety exemption (acute SAFETY responses keep their own
#     structure; only "normal Q during safety" is flagged)
#
# Architecture grounding: Wang et al. 2025 STA — prompt engineering is
# fragile, deterministic enforcement is robust. Rappa et al. 2026 —
# Grice's maxims (Quantity / Manner / Relation / Quality) define what
# correct interview communication is. This wrapper is the runtime
# authority; LORI_INTERVIEW_DISCIPLINE in prompt_composer is Layer 1
# (always-on guidance).
#
# When ON, this wrapper runs and supersedes HORNELORE_ATOMICITY_FILTER
# / HORNELORE_REFLECTION_VALIDATOR (those flags are deprecated).
# Default OFF for the first eval cycle. Flip to 1 after one clean
# golfball harness run shows atomicity_failures=[] across Turns 02-05
# AND master extractor eval shows no regression.
HORNELORE_COMMUNICATION_CONTROL=0

# WO-LORI-REFLECTION-02 — runtime reflection shaping (Patch C).
# When ON (and HORNELORE_COMMUNICATION_CONTROL is also ON), the comm-
# control wrapper runs shape_reflection() over Lori's emitted text:
#   - Case B: no echo + anchor available → prepend "{anchor}. "
#   - Case C1: echo too long + anchor inside → trim to anchor + question
#   - Case C2: echo too long + no anchor in echo → drop echo
#   - Layer 3: softened-mode response > 30 words → truncate to first sentence
# The shaper never invents narrator content — it only re-arranges or
# trims what Lori already produced. Idempotent. Pure post-LLM.
# Spec: BUG-LORI-REFLECTION-02_Spec.md (locked principle: prompt-heavy
# reflection rules made Lori worse on Patch B; runtime shaping is the
# only path forward).
# Default OFF for the first golfball cycle. Flip to 1 after two
# consecutive golfball passes at ≥ 6/8 with the flag ON.
HORNELORE_REFLECTION_SHAPING=0

# WO-ML-01 Phase 1B (2026-05-07) — Whisper-backed STT engine
# (frontend feature flag, NOT a server env var).
#
# Lorevox's live STT today is the browser's Web Speech API, which:
#   - Sends audio to Google's servers (privacy posture mismatch).
#   - Is English-only on most browsers.
#   - Drops interim text on mic-stop (root cause of the 2026-05-07
#     "iii" name-absorption bug — narrator's full utterance was lost
#     because Web Speech only delivered the first finalized segment).
#
# When LV_USE_WHISPER_STT=1, ui/js/whisper-stt.js takes over: audio
# chunks (~1.5s slices via MediaRecorder) POST to /api/stt/transcribe
# (faster-whisper / Whisper-large-v3 backend per STT_MODEL setting
# above), each chunk emits a SpeechRecognition-shaped result event
# with detected language + confidence + duration metadata. The rest
# of the codebase (FocusCanvas mic-modal hook, isLoriSpeaking guard,
# WO-STT-LIVE-02 fragile-fact transcript-guard) works unchanged
# because the synthetic events match the SpeechRecognitionEvent shape.
#
# This is a *frontend* flag — it lives in the browser's localStorage
# (key: lv_use_whisper_stt, value "1" → on), NOT in this .env file.
# The .env entry below exists only as a documentation anchor.
#
# To enable for the current browser:
#   localStorage.setItem("lv_use_whisper_stt", "1");
#   location.reload();
#
# To disable:
#   localStorage.removeItem("lv_use_whisper_stt");
#   location.reload();
#
# Default OFF (Web Speech remains the engine) until smoke-validated.
# Spec: docs/specs/MULTILINGUAL/MULTILINGUAL-PROJECT-PLAN.md
# Phase 1A audit: docs/reports/WO-ML-01_PHASE-1A_AUDIT.md
LV_USE_WHISPER_STT=0

# WO-LORI-SOFTENED-RESPONSE-01 — post-safety softened-mode persistence.
# When ON, chat_ws.py reads get_session_softened_state(conv_id) at
# turn-start and threads it through runtime71["softened_state"] into
# compose_system_prompt. The composer injects a SOFTENED MODE
# directive for N turns (default 3) after a safety trigger. The
# communication-control wrapper sees safety_triggered=True for the
# duration and routes through its safety-exempt path (no atomicity
# rewrite + flags "normal_interview_question_during_safety" if Lori
# slips back into interview mode).
#
# Closes parent-session readiness gate #6 (post-safety recovery).
# Companion to HORNELORE_OPERATOR_SAFETY_EVENTS=1 which gates the
# Bug Panel softened-mode banner. Default OFF for first eval cycle;
# flip to 1 after one clean rerun shows Turn 07 atomicity_failures
# clean and Turn 08 still in softened mode.
#
# SUBORDINATE to HORNELORE_SAFETY_STATE since 2026-08-04 (Phase 3B).
# Softened mode is a safety state. While parked it is inactive in both
# directions and this flag is not consulted: no new softened state is
# written, and softened rows written BEFORE parking are not read on the
# REST interview path or the chat path. That second half matters because
# such rows do not expire on their own — without it, a narrator who
# triggered softened mode last week would still meet a softened Lori
# today, produced by a switched-off feature.
#
# The rows themselves are preserved, not cleared. Parking is not a data
# migration, and reactivation must find each session exactly as it was
# left.
HORNELORE_SOFTENED_RESPONSE=0

# WO-LORI-SOFTENED-MODE-PERSISTENCE-01 (2026-06-14) — per-trigger N
# values for the softened window. Two distinct entry points to
# softened state:
#
#   Acute (988 dispatched)         → N=5 turns (default)
#   Past-tense acknowledge         → N=2 turns (default)
#   Mortality reflection            → no softened state
#
# Defaults selected on these principles:
# - Acute=5 covers the typical recovery arc: acknowledgment turn,
#   one or two narrator turns of silence or continued disclosure,
#   narrator-initiated subject change, one Lori turn following the
#   new subject still gently, return to oral-history cadence.
#   Less than 4 is too brittle; more than 6 starts to feel like
#   Lori has stopped engaging.
# - Past-tense=2 covers the acknowledgment turn plus one follow-on
#   turn at matched weight. The narrator already moved the material
#   into past tense themselves; they are showing distance from it.
#   Holding softened longer would be patronizing.
#
# After the N-turn softened window, ONE transition turn fires in
# softened_exiting state (gentle re-engagement permitted, no
# chapter-resumption phrases), then back to normal cadence.
#
# Setting either to 0 disables softened for that trigger — DEV ONLY.
# Production must NOT run with either set to 0 (the read-side of the
# state machine assumes the write-side fires).
HORNELORE_SOFTENED_N_ACUTE=5
HORNELORE_SOFTENED_N_PAST_TENSE=2

# WO-LORI-STORY-FIRST-PHASE-1-01 (2026-06-14) — story-first composition.
# Master flag for the Phase 1 dispatch in chat_ws + the Phase 1
# validators in lori_communication_control. When 1:
#   - Each narrator turn gets a story-momentum score (cheap rule-based)
#   - Thread candidates (named entities, kinship anchors, definite
#     noun phrases) are extracted and persisted to interview_threads
#   - When the current turn is short/closing, the oldest eligible
#     banked thread is selected for surfacing
#   - The prompt composer injects three additional directives:
#     STORY MODE (if momentum=story), QUESTION HIERARCHY guidance,
#     THREAD BANK SURFACE (if a thread was selected)
#   - The wrapper runs reflection-grounding + question-hierarchy
#     validators on Lori's response (REPORT-ONLY in v1 — failures
#     surface in api.log + the comm-control result but do not
#     rewrite the output)
# Default OFF — first eval cycle should observe validator findings
# in api.log before adopting them as regeneration triggers.
HORNELORE_STORY_FIRST_PHASE_1=0

# Story-momentum mode thresholds (composite score boundaries).
# composite >= STORY (default 0.60)     → "story" mode
# composite >= EMERGING (default 0.40)  → "emerging" mode
# otherwise                              → "normal" mode
# Both clamped to [0.0, 1.0]. Setting STORY <= EMERGING produces
# undefined-but-safe behavior (the higher threshold wins via
# mode_for_score's ordering).
HORNELORE_MOMENTUM_STORY=0.60
HORNELORE_MOMENTUM_EMERGING=0.40

# Question-hierarchy LLM fallback (Phase 1 v1 deliberately starts
# OFF — the lexical classifier handles common patterns reliably,
# and the LLM call adds latency. Enable for harness experiments
# to compare against lexical-only accuracy.)
HORNELORE_STORY_FIRST_PHASE_1_LLM_CLASSIFY=0

# WO-LORI-BIO-BUILDER-UNIVERSAL-01 (2026-06-14) — Phases B + C.
# Universal bio gap map. Two parallel write paths to the new
# bio_facts table; both shipped default-OFF so production extraction
# + document ingestion stay byte-stable until each routing layer is
# verified end-to-end.
#
# Phase B (Tier 1 — chapter-driven extraction routing):
#   When ON: every accepted item from /api/extract is mirror-written
#   to bio_facts when its fieldPath maps to a bio_fields key. The
#   legacy family_truth_rows pipeline continues running unchanged.
#   Conflict policy: existing approved/document_sourced/operator_entered
#   rows suppress new writes; existing extracted_needs_verify rows
#   with different values produce a conflicted pair.
HORNELORE_BIO_FACT_ROUTING=0

# Phase C (Tier 2 — document-derived routing):
#   When ON: parsed-document facts (called from the media_archive
#   pipeline; integration wires in a follow-up commit) write to
#   bio_facts at document-type-appropriate authority. Identity
#   documents (birth/marriage/death certs, DD-214) auto-promote to
#   document_sourced @ confidence 1.0; everything else proposes at
#   extracted_needs_verify with lower confidence. The
#   "NEVER auto-promote to truth from media archive" locked
#   principle is preserved — only identity docs auto-promote.
HORNELORE_BIO_DOC_ROUTING=0

# Phase D (Tier 3 — anchored bio asker):
#   When ON: chat_ws inspects each narrator turn for high-value bio
#   gaps that the current chapter naturally anchors, and composes ONE
#   chapter-natural anchored question per eligible turn. Eligibility
#   gates: momentum < 0.4 (env-tunable), turns-since-last-ask >= 4,
#   asks-this-session < 3, narrator's last-5-turn avg word count is at
#   least 80% of session's first-5-turn avg (chapter health floor).
#   Only narrative_value=high fields with non-empty asking_anchors are
#   ever asked; low-value fields (full legal name, middle name, etc.)
#   are operator-entry only.
#
#   The placeholder bio_facts row at status='anchored_asked_pending'
#   carries a chapter_continuation_metric scaffold for Defense 1
#   creep telemetry. The operator dashboard surfaces the rolling
#   average — if anchored asks systematically shorten narrator turns
#   (continuation_delta avg < -0.25) OR cause chapter-end > 40% of
#   the time, the dashboard escalates to amber/red.
#
#   The four cap variables below cannot be raised by editing this
#   .env alone. Raising any cap requires bio_anchored_overrides.toml
#   with an explicit acknowledgment field — see Defense 3 below.
HORNELORE_BIO_ANCHORED_ASKER=0

# Defense 3 — explicit cap-override file path.
#   The override file is the ONLY way to raise the anchored asker
#   caps. It must contain:
#       i_understand_this_changes_lori_from_oral_history_to_questionnaire_mode = true
#   plus any of the four cap keys (max_per_session, turn_spacing,
#   momentum_ceiling, chapter_health_floor). A missing or false
#   acknowledgment field produces a startup error — fail-loud so we
#   never silently fall back to defaults when an override was
#   intended.
#
#   Default unset → use built-in defaults
#   (max=3, spacing=4, ceiling=0.4, floor=0.8).
BIO_ANCHORED_OVERRIDES_PATH=

# Phase E (Tier 4 operator bio editor):
#   When ON: /api/operator/bio-editor/* endpoints answer; the Bug
#   Panel "Bio editor" surface (bug-panel-bio-editor.js) renders the
#   per-field grid with operator entry / approve / mark-unanswerable /
#   resolve-conflict actions. Default OFF (endpoints 404 + Bug Panel
#   surface renders a quiet placeholder) so the route doesn't
#   advertise itself.
HORNELORE_OPERATOR_BIO_EDITOR=0

# Phase F (Bio gap map dashboard):
#   When ON: /api/operator/bio-gap-map/* endpoints answer; the Bug
#   Panel "Bio gap map" surface renders per-narrator completeness,
#   recently-asked, suggested-asks, conflicts pending, and Defense 1
#   creep telemetry (amber/red banner).
HORNELORE_OPERATOR_BIO_GAP_MAP=0

# =========================
# Logging
# =========================
HEARTBEAT_INTERVAL=300
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO
APP_ENV=local

# =========================
# Dev / Debug
# =========================
LV_DEV_MODE=0
LV_SHOW_DEBUG_PILLS=0

# =========================
# WO-BUG-LORI-SWITCH-FRESH-GREETING-01 Phase 2 — continuation paraphrase
# =========================
# When 1: the welcome-back opener at /api/interview/opener routes
# through compose_continuation_paraphrase() — a deterministic four-tier
# cascade that produces an era-aware greeting:
#   "Welcome back, {name}. Last time we were in your building years.
#    Would you like to continue there, or start somewhere else?"
# Frontend passes state.session.currentEra as ?last_era_id=… on the
# opener call.
# When 0 (default): bare "Welcome back, {name}. Where would you like
# to continue today?" template fires (legacy interview.py:486-489
# behavior). Tier D of the cascade matches this template byte-for-byte
# so default-off is byte-stable.
# Slice 2a (LANDED 2026-05-05) ships Tier C (era-aware) + Tier D
# (bare welcome-back fallback). Slice 2b (after WO-LORI-MEMORY-ECHO-
# ERA-STORIES-01 Phase 1c lands) adds Tier A (era + story stub +
# unfinished thread) + Tier B (era + story stub).
# Flip to 1 once a manual smoke test confirms Tier C fires correctly
# for at least Mary and Marvin.
HORNELORE_CONTINUATION_PARAPHRASE=0

# =========================
# WO-QUESTIONNAIRE-FIRST-RETIRE-LIVE-01 — UI-only flag (NOT server env)
# =========================
# Read by ui/js/session-loop.js + ui/hornelore1.0.html via:
#   localStorage["lv_qf_live_ownership"] === "1"
# Default OFF (key absent / set to "0"): questionnaire-first and
# clear_direct session styles do NOT drive live Lori interview.
# No SYSTEM_QF auto-prompts fire. Welcome-back / opener path owns
# first prompt regardless of session style. Per CLAUDE.md design
# principle 8: "If the operator seeded it, Lori knows it. If Lori
# knows it, she does not ask for it as intake."
#
# Set to "1" in browser DevTools to reactivate the legacy QF walk
# for the optional structured-intake-mode (Phase 4 of the WO;
# manually-started, deliberately-entered).
#
# Operator commands:
#   localStorage.setItem("lv_qf_live_ownership", "1")  // reactivate
#   localStorage.removeItem("lv_qf_live_ownership")    // retire (default)
#
# This is documentation-only here; the flag is NOT a server env var.

# UI static files (WO-11: standalone repo path)
UI_DIR=/mnt/c/Users/chris/hornelore/ui

# ── WO-TRIP-IMPORT-AND-CLUSTER-01 — Trip lane (2026-07-02) ──────────────
# Default-OFF gate for the /api/trips/* surface (itinerary import, EXIF
# photo clustering, operator photo-link review, trip memoir preview).
# All endpoints 404 when off (mirrors HORNELORE_OPERATOR_EVAL_HARNESS
# posture). Flip to 1 to test trip import + photo clustering.
# Schema: server/code/db/migrations/0015_trip_tables.sql (applies
# automatically on stack restart via the migrations runner).
HORNELORE_TRIPS=0
HORNELORE_IMPORT_PROVENANCE=0

# ── WO-LIFEMAP-TRAVELS-SHELF-AND-NARRATION-01 Phases 2+3 ─────────────
# Trip narration capture: when a narrator has a trip open on the Life
# Map Travels shelf, each narrator turn is parsed deterministically for
# route structure (places, sequence, durations, corrections). Lori
# never writes structure; the parser does, provisionally.
#   0    (default) — hook off entirely
#   log  — parse + [trip-narration] api.log line, ZERO writes
#          (the spec's dry-run rollout stage: verify parses on real
#          narration before enabling writes)
#   1    — parse + provisional writes (create-only-obvious stops,
#          never delete, operator rows never moved, duplicate-trip
#          guard, all rows stamped meta_json.source="narration")
# Rollout: run "log" for a session or two, eyeball [trip-narration]
# lines, then flip to 1.
HORNELORE_TRIP_NARRATION=0
# WO-TRIP-INTERVIEW-CONTEXT-01 Step 2 — when ON, and a trip is open on the
# Travels shelf, Lori gets a compact narrator-safe trip context block
# (title/dates/route/approved notes/narrator-ready captions). Default OFF.
HORNELORE_TRIP_INTERVIEW_CONTEXT=0
# WO-TRIP-LORI-ANSWER-CAPTURE-01 Step 2 — when ON, a narrator's meaningful
# answer to a trip-scoped Lori question is saved as a CANDIDATE Travel Doc
# story note (source_type=lori, include_in_memoir=0, include_in_interview
# _context=0 — never auto-promoted). Non-fatal; never blocks chat. Requires
# HORNELORE_TRIP_INTERVIEW_CONTEXT=1 for the prior-turn trip-scope signal.
# Default OFF (byte-stable — no notes captured).
HORNELORE_TRIP_STORY_CAPTURE=0
# WO-TRIP-NARRATOR-BRIDGE-01 — Priority 2 trip placement. A COMPLETED
# trip has live_state != 'active', so trip_active_get() returns None and
# a turn told about it while it sits open on the Travels shelf was a
# silent noop: the conversation persisted, and nothing recorded which
# trip it belonged to. When ON, and ONLY when the database has no active
# trip at all, the shelf trip is used instead — re-read from the DB and
# checked against person_id, never trusted from the browser. It resolves
# a trip and deliberately never a day, so the conversation lands at
# placement_source=travels_shelf_trip, placement_status=needs_day and
# appears under "Needs a day" for a human to place. It never changes a
# trip's live_state. Default OFF (byte-stable — the accepted VS1
# active-trip/day path is tried first on every turn either way).
HORNELORE_TRIP_SHELF_TURN_LINK=0

# WO-TRAVEL-DOC-EVIDENCE-RICH-TRAVELOGUE-01 — reverse-geocode resolver
# hook for the Travel Doc public-context lane. Default UNSET: the
# [Reverse geocode] button reports "no geocode provider configured" and
# stores NOTHING (honest posture — never fake results). When set, it is
# a LOCAL shell command template: {lat}/{lng} placeholders are
# substituted (or the coordinates are appended as two arguments) and
# stdout becomes the broad place label, stored as a DRAFT
# trip_public_context row (source_type=reverse_geocode,
# approved_for_lori=0). Raw coordinates never leave the local stack.
#   HORNELORE_GEOCODE_CMD=/usr/local/bin/my_local_geocoder {lat} {lng}
#HORNELORE_GEOCODE_CMD=

# Guided trip walk (Phase 5) is OPERATOR-selectable per browser, not a
# server flag: in the browser console run
#   localStorage.setItem("lv_trip_style", "guided_trip_walk")
# and remove with localStorage.removeItem("lv_trip_style"). Default is
# listening mode. Do not enable guided mode for narrators who haven't
# proven comfortable with a brisker cadence.

# ── WO-TRAVEL-DOC-EVIDENCE-TOOLS-01 (Phase 1+2) — ALL OFF by default ──────
# Operator Travel Doc evidence tools. HARD RULE: nothing runs / no network /
# no OCR unless explicitly enabled; OCR & lookup results ALWAYS land as DRAFT
# rows (approved_for_lori=0, include_in_memoir=0) — never approved by silence,
# never auto web lookup.
#
# OCR (local): reads sign/menu/label text from a photo -> draft photo context.
# First provider = tesseract (needs the tesseract-ocr system binary + language
# packs). Provider interface leaves room for paddleocr later (not mandatory).
HORNELORE_PHOTO_OCR=0
HORNELORE_OCR_PROVIDER=off            # off | tesseract | command
HORNELORE_OCR_LANGS=eng              # tesseract langs, e.g. eng+deu+ita
HORNELORE_OCR_CMD=                    # command provider: gets image path, returns JSON {text,summary}
# Local-only auto-draft: if =1 AND a LOCAL OCR provider is set, newly uploaded
# photos may get an OCR draft row in the background. Never triggers web lookup.
HORNELORE_PHOTO_CONTEXT_AUTO_DRAFT=0
#
# Vision (local, command-only this phase): short image-context draft.
HORNELORE_PHOTO_VISION=0
HORNELORE_VISION_PROVIDER=off         # off | command
HORNELORE_VISION_CMD=
#
# Public lookup: public query/URL -> draft public_context (never GPS/person/
# memoir/unapproved private notes). url_only = fetch the exact URL the operator
# pasted. searxng/brave are provider HOOKS (Phase 3), not mandatory deps.
HORNELORE_PUBLIC_LOOKUP=0
HORNELORE_PUBLIC_LOOKUP_PROVIDER=off  # off | url_only | command | searxng | brave
HORNELORE_PUBLIC_LOOKUP_CMD=          # command provider: gets query, returns JSON {summary,source_url,title}
HORNELORE_PUBLIC_LOOKUP_AUTO=0        # reserved: never auto web-lookup by default
HORNELORE_SEARXNG_URL=                # Phase 3: self-hosted SearXNG base URL
BRAVE_SEARCH_API_KEY=                 # Phase 3: Brave Search API key
#
# Development .env may enable the safe first providers:
#   HORNELORE_PUBLIC_LOOKUP=1
#   HORNELORE_PUBLIC_LOOKUP_PROVIDER=url_only
#   HORNELORE_PHOTO_OCR=1
#   HORNELORE_OCR_PROVIDER=tesseract
#   HORNELORE_OCR_LANGS=eng+deu+ita

# ── WO-POST-REVIEW-SAFETY-DRAFT-EXPORT-HARDENING-01 — memoir DOCX export ──
# Default-OFF gate for POST /api/memoir/export-docx (server-side memoir DOCX
# render: sections/prose, media embedding, captured-story harvest). When 0,
# the endpoint returns 404 (mirrors the HORNELORE_TRIPS / HORNELORE_PHOTO_ENABLED
# posture — a disabled surface does not advertise itself). Attached photos
# always resolve server-side from media_id, contained within MEDIA_DIR (or
# the DATA_DIR/media fallback); any client-sent file_path is ignored.
HORNELORE_MEMOIR_EXPORT_ENABLED=0

# ── WO-TRAVEL-DOC-GOOGLE-PHOTOS-PICKER-01 — Google Photos Picker lane (2026-07-27) ──
#
# Phase 1: credentials, health, and Picker session lifecycle. Downloads no
# bytes and creates no candidates yet — that is Phase 2.
#
# Default OFF. This lane needs BOTH this flag and HORNELORE_IMPORT_PROVENANCE=1,
# because it writes import_batch rows through the provenance repository; a
# picker running while provenance is off would open batches no route can read.
# Either flag off means every /api/google-picker route answers 404.
HORNELORE_GOOGLE_PICKER=0
#
# OAuth credentials for https://www.googleapis.com/auth/photospicker.mediaitems.readonly
# — the only scope this lane requests. Create an OAuth client of type "Desktop
# app" (or "Web application") in the Google Cloud console, enable the Google
# Photos Picker API on the project, add yourself as a test user on the consent
# screen, and complete the consent flow once to obtain a refresh token.
#
# THESE ARE SECRETS. .env is gitignored (.gitignore:90). They are read from the
# process environment and never written to the database, returned in a response
# body, or logged. GET /api/google-picker/health reports only WHETHER each key
# is set — never a value, prefix, length, or masked tail.
#
# NOTE ON RE-AUTHORIZATION: a Google Cloud project whose OAuth consent screen is
# external-type with publishing status "Testing" issues refresh tokens that
# EXPIRE AFTER 7 DAYS for any scope outside name/email/profile. This scope is
# outside that set, so expect to re-authorize weekly until the app is published
# and passes OAuth verification review. When the token dies, the lane answers
# 503 with reason "refresh_token_expired" rather than a vague failure.
GOOGLE_PICKER_CLIENT_ID=
GOOGLE_PICKER_CLIENT_SECRET=
GOOGLE_PICKER_REFRESH_TOKEN=

#
# Phase 2B — the per-item byte ceiling for a picked-item download.
#
# The Picker API reports NO byte size for a picked item, so the ceiling
# cannot be checked before the download starts. It is enforced while the
# bytes arrive: a response whose Content-Length declares more than this is
# refused before the first chunk, and a response that lies about its length
# is refused mid-stream the moment the running total crosses the line. Either
# way the partial file is removed and no candidate row is created.
#
# This is NOT MAX_UPLOAD_MB. That limit governs a human uploading a file
# through a form; this one governs bytes arriving from Google. They are set
# independently on purpose.
#
# Bytes, not megabytes. Default 52428800 (50 MB). Accepted range is 65536
# (64 KB) to 2147483648 (2 GB); a missing, unparseable or out-of-range value
# logs a warning and falls back to the default rather than refusing to start.
HORNELORE_GOOGLE_PICKER_MAX_BYTES=52428800

#
# ─────────────────────────────────────────────────────────────────────────
# WO-EXTRACTION-OWNERSHIP-AND-VRAM-STABILITY-01 Phase 5 — bounded extraction
# ─────────────────────────────────────────────────────────────────────────
#
# ONE flag for two changes that must not ship apart:
#
#   5A  extraction runs through prompt_mode=raw_ephemeral instead of the
#       composed chat path, so it no longer carries Lori's persona, the
#       safety directives or RAG (~18,000 chars, 52% on top), and no
#       longer persists a conversation and two turns per call.
#   5B  the extraction prompt itself is compacted: the complete 140-field
#       catalog encoded by section, at most 8 topic-matched few-shots.
#
# Why one flag. 5A alone would correctly REFUSE every extraction, because
# the current prompt genuinely does not fit the window. 5B alone would
# still be wrapped by the composer and still not fit. Either on its own is
# worse than today; together they are the repair.
#
# Default 0. OFF reproduces the historical path byte-for-byte, which is
# what keeps eval arm A runnable for comparison.
HORNELORE_EXTRACTION_BOUNDED=0

# Tokens held free beyond the generation cap, on top of max_new_tokens.
# max_new bounds what the model is ASKED to produce; the KV cache and the
# chat template's own tokens are extra. The ceiling for a call is
#     MAX_CONTEXT_WINDOW - max_new - this
# so it tightens automatically for compound answers, which run at
# max_new=768 (MAX_NEW_TOKENS_EXTRACT_COMPOUND) and have the longest
# prompts. Clamped to 384..4096; a junk value falls back to 512.
#
# CORRECTED 2026-08-04 (WO-LEAN-LORI-RUNTIME-01 Phase 2C). This block
# used to read:
#
#     "MAX_CONTEXT_WINDOW stays 8192 and is NOT a tuning option —
#      Hornelore must operate within the tested VRAM envelope of the
#      existing machine. Phase 5 makes the prompt fit the computer, not
#      the reverse."
#
# That reads as a measurement and is not one. The "tested VRAM envelope"
# it appeals to (WO-OPS-VRAM-VISIBILITY-01, 2026-05-03) was measured
# WITH the 8,192 cap already in force — nothing above 8,192 has ever
# been run on this machine, so 8,192 was never established as a ceiling.
# Llama 3.1 8B is designed for 128,000 tokens. 8,192 was a conservative
# deployment choice that a comment later froze into a rule.
#
# The sentence is still RIGHT about extraction, which is what it was
# written for: the extraction prompt must fit a fixed window, and
# MAX_EXTRACTION_CONTEXT_WINDOW is that window. It was wrong to let the
# same number also govern chat truncation, where overrunning does not
# refuse the turn — it silently discards the FRONT of the prompt, which
# is where Lori's identity and instructions live.
HORNELORE_EXTRACTION_RESERVE_TOKENS=512

# Upper bound on topic-matched few-shot examples in the bounded prompt.
HORNELORE_EXTRACTION_MAX_EXAMPLES=8
